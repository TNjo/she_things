# ---- Core ----
# Long random strings (e.g. `openssl rand -base64 48`). REQUIRED in production.
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ADMIN_SESSION_SECRET=change-me-to-a-different-long-random-string-32-chars
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Seed admin (dummy data mode). Change before deploying!
ADMIN_EMAIL=admin@shethings.lk
ADMIN_PASSWORD=SheThings@2026

# ---- Payments ----
# "mock" = built-in test gateway (every flow works, no real money). "live" = real providers.
PAYMENT_MODE=mock

# PayHere (cards) - https://www.payhere.lk
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true

# Koko BNPL - credentials from Koko merchant portal
KOKO_MERCHANT_ID=
KOKO_API_KEY=
KOKO_PUBLIC_KEY=
KOKO_PRIVATE_KEY=

# Mintpay BNPL - credentials from Mintpay merchant portal
MINTPAY_MERCHANT_ID=
MINTPAY_SECRET=

# Bank transfer details shown to customers
BANK_NAME=Commercial Bank
BANK_ACCOUNT_NAME=She Things (Pvt) Ltd
BANK_ACCOUNT_NUMBER=8000 1234 5678
BANK_BRANCH=Colombo 07

NEXT_PUBLIC_WHATSAPP=94770000000

